{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "rootDir": ".",
    "outDir": "dist",
    "paths": {
      "@gorilli/gantry-mcp": ["./src/index.ts"],
      "@gorilli/gantry-mcp/modules": ["./src/modules/index.ts"],
      "@gorilli/gantry-mcp/modules/*": ["./src/modules/*.ts"],
      "@gorilli/gantry-mcp/testing": ["./src/testing/index.ts"]
    }
  },
  "include": ["src", "stores", "test", "examples", "bench"]
}
